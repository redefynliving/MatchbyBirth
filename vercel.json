{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm ci && npm run build --prefix apps/web",
  "outputDirectory": "dist/apps/web",
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/{astronomia,city-timezones,luxon}/**"
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.matchbybirth.com"
        }
      ],
      "destination": "https://matchbybirth.com/",
      "permanent": true
    },
    {
      "source": "/blog/mercury-retrograde-dating-guide",
      "destination": "/blog/mercury-retrograde-2026-relationships",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.matchbybirth.com"
        }
      ],
      "destination": "https://matchbybirth.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/how-it-works", "destination": "/how-it-works/index.html" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/disclaimers", "destination": "/disclaimers/index.html" },
    { "source": "/refund-policy", "destination": "/refund-policy/index.html" },
    { "source": "/premium", "destination": "/premium/index.html" },
    { "source": "/sample-report", "destination": "/sample-report/index.html" },
    { "source": "/report-delivery", "destination": "/report-delivery/index.html" },
    { "source": "/tools/crush-birthday-compatibility", "destination": "/tools/crush-birthday-compatibility/index.html" },
    { "source": "/tools/life-path-compatibility", "destination": "/tools/life-path-compatibility/index.html" },
    { "source": "/tools/moon-sign-compatibility", "destination": "/tools/moon-sign-compatibility/index.html" },
    { "source": "/tools/team-compatibility", "destination": "/tools/team-compatibility/index.html" },
    { "source": "/daily-horoscope", "destination": "/daily-horoscope/index.html" },
    { "source": "/weekly-horoscope", "destination": "/weekly-horoscope/index.html" },
    { "source": "/blog/category/:slug", "destination": "/blog/category/:slug/index.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/404", "destination": "/404/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/result",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/admin/funnel",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/404",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/retry-failed-reports",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/send-weekly-updates",
      "schedule": "0 9 * * 1"
    }
  ]
}
