{
  "buildCommand": "cd apps/web && npm ci && npm run build",
  "outputDirectory": "dist/apps/web",
  "framework": null,
  "functions": {
    "api/og.js": {
      "runtime": "edge"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
