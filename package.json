{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\" \"npm run dev --prefix apps/api\"",
    "build": "concurrently --raw \"npm run build --prefix apps/web\" \"npm run build --prefix apps/api\"",
    "start": "concurrently --kill-others --raw \"npm run start --prefix apps/api\"",
    "lint": "concurrently --raw \"npm run lint --prefix apps/web\" \"npm run lint --prefix apps/api\"",
    "test": "node --test tests/*.test.cjs",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "blog:check": "node scripts/check-blog-ledger.mjs",
    "content:check": "node scripts/check-content-quality.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "workspaces": [
    "apps/*"
  ],
  "dependencies": {
    "@vercel/og": "^1.0.0",
    "astronomia": "^4.2.0",
    "city-timezones": "^1.3.4",
    "luxon": "^3.7.2",
    "stripe": "^22.2.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  }
}
