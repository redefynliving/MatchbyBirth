APP_URL=https://matchbybirth.com
# Vercel: api/index.js supplies the response helpers this project uses.
NODEJS_HELPERS=0

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Test and Preview environments should use sk_test_*, test prices, and a test webhook secret.
# Live checkout stays disabled unless both values below are set after Stripe Checkout shows Match by Birth branding.
STRIPE_MERCHANT_NAME=Match by Birth
STRIPE_LIVE_CHECKOUT_ENABLED=false

ANTHROPIC_API_KEY=
RESEND_API_KEY=

REPORT_TOKEN_SECRET=
FUNNEL_DASHBOARD_TOKEN=
CRON_SECRET=
