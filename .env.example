APP_URL=https://matchbybirth.com
# Vercel: api/index.js supplies the response helpers this project uses.
NODEJS_HELPERS=0

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Test and Preview environments should use sk_test_*, test prices, and a test webhook secret.
# Live checkout stays disabled unless both values below are set after Stripe Checkout shows Match by Birth branding.
STRIPE_MERCHANT_NAME=Match by Birth
STRIPE_LIVE_CHECKOUT_ENABLED=false

# Printful (POD fulfillment). Server-side only — never exposed to the client.
# Create a free Printful store, generate a API key, and paste it here to go live.
# Without it, /api/printful-products returns { configured: false } and the shop
# page falls back to its built-in SVG design previews (no fake inventory).
PRINTFUL_API_KEY=

ANTHROPIC_API_KEY=
RESEND_API_KEY=

REPORT_TOKEN_SECRET=
FUNNEL_DASHBOARD_TOKEN=
CRON_SECRET=
